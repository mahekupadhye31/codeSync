# ── Database ──────────────────────────────────────────────
POSTGRES_PASSWORD=changeme_db

# ── Redis ─────────────────────────────────────────────────
REDIS_PASSWORD=changeme_redis

# ── JWT ───────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 64
JWT_SECRET=changeme_jwt_secret_at_least_32_characters_long

# ── GitHub OAuth ──────────────────────────────────────────
# Create an OAuth App at https://github.com/settings/developers
# Homepage URL:        http://localhost
# Callback URL:        http://localhost/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_CALLBACK_URL=http://localhost/api/auth/github/callback

# ── App URLs ──────────────────────────────────────────────
CLIENT_URL=http://localhost
VITE_API_URL=/api
VITE_WS_URL=ws://localhost/ws

# ── Monitoring ────────────────────────────────────────────
# Renamed from GRAFANA_PASSWORD in Phase 4 to match docker-compose variable
GRAFANA_ADMIN_PASSWORD=admin

# ── Judge0 CE (self-hosted) ───────────────────────────────
# No external API key required — Judge0 runs inside Docker.
# Within the Docker network the default value below is used automatically;
# only set these if you override the internal URL (e.g. a remote Judge0 instance).
JUDGE0_API_URL=http://judge0-server:2358
JUDGE0_AUTH_TOKEN=local_dev_token

# ── CI / CD (Phase 4) ─────────────────────────────────────
# Set these as GitHub Actions secrets, NOT in .env files.
# GITHUB_TOKEN is provided automatically by Actions (no setup needed).
#
# SSH deploy key — generate with:
#   ssh-keygen -t ed25519 -C "codesync-deploy" -f ~/.ssh/codesync_deploy
#   # Add public key to ~/.ssh/authorized_keys on the server
#   # Add private key as DEPLOY_KEY secret in GitHub repo settings
DEPLOY_HOST=your.server.ip.or.hostname
DEPLOY_USER=ubuntu
# DEPLOY_KEY  ← paste the private key in GitHub Actions secrets (not here)

# ── Load testing (Phase 4) ────────────────────────────────
# Override when the stack is not on localhost
LOAD_TEST_BASE_URL=http://localhost
